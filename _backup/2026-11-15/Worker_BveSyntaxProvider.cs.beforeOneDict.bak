        public static HashSet<string> GetValidCommands()
        {
            var validCommands = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var syntax in GetAllSyntaxes())
            {
                string text = syntax.Text;
                if (string.IsNullOrEmpty(text)) continue;
                if (text.StartsWith("BveTs Map", StringComparison.OrdinalIgnoreCase))
                {
                    validCommands.Add("BveTs Map");
                    continue;
                }

                // ★ 角括弧 ['...'] 部分をあらかじめ除去してからコマンド名を抽出する
                // 例: Track[''].Position(); -> Track.Position();
                string normalizedText = Regex.Replace(text, @"\[\s*['""].*?['""]\s*\]", string.Empty);
                normalizedText = Regex.Replace(normalizedText, @"\[\s*\d+\s*\]", string.Empty);

                int index = normalizedText.IndexOfAny(new[] { '(', ' ', ';' });
                string commandName = index >= 0 ? normalizedText.Substring(0, index) : normalizedText;

                if (!string.IsNullOrEmpty(commandName))
                {
                    validCommands.Add(commandName);
                    // 互換性のため、名前空間単体（例: Track, Repeater）や既存の登録も許容する
                    int dotIndex = commandName.IndexOf('.');
                    if (dotIndex > 0)
                    {
                        validCommands.Add(commandName.Substring(0, dotIndex));
                    }
                }
            }
            return validCommands;
        }
    }
}