        // 子パス -> 親パス の紐付けを記録する辞書
        private Dictionary<string, string> _childToParentMap = new(StringComparer.OrdinalIgnoreCase);
        // ★ キーの自動補完用: ルートファイルごとの「読み込んだリストのキーの一覧」（構文チェックのたびにワーカーから受け取る）
        //    ルートファイルのパス（無題は ""）→（"Structure" などの種類 → キー）
        private readonly Dictionary<string, Dictionary<string, List<string>>> _keyListsByRoute = new(StringComparer.OrdinalIgnoreCase);
        // ★ 接続先のパイプサーバーのプロセスIDを取得するためのWin32 API
        [System.Runtime.InteropServices.DllImport("kernel32.dll", SetLastError = true)]
        private static extern bool GetNamedPipeServerProcessId(Microsoft.Win32.SafeHandles.SafePipeHandle hPipe, out uint serverProcessId);
        private string? _currentProjectPath = null; // ★ 現在開いている .bveproj のパス
        private Process? _parserWorkerProcess; //プロセス
        // ★ パイプ通信の名前。エディタごとに違う名前にする（エディタのプロセスIDを付ける）
        //    以前は固定の名前で、別のプログラムが先に同じ名前のパイプを作ると、そちらに接続してしまう恐れがあった（なりすまし）
        //    また、エディタを2つ起動すると、2つ目のワーカーがパイプを作れずに CPU を使い続けていた
        private static readonly string PipeName = $"BveMapParserPipe_{Environment.ProcessId}";
        // アプリ起動時（MainWindowのコンストラクタなど）にワーカーを起動
        private void StartParserWorker()
        {
            App.LogOperation("パーサーワーカーを起動");
            try
            {
                // ワーカープロセスのEXEパスを指定（ビルド構成に合わせて調整）
                string workerPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "BveMapParserWorker.exe");
                if (File.Exists(workerPath))
                {
                    _parserWorkerProcess = new Process
                    {
                        StartInfo = new ProcessStartInfo
                        {
                            FileName = workerPath,
                            Arguments = $"--worker --pipe {PipeName}", // ★ 起動用引数と、このエディタ専用のパイプの名前
                            UseShellExecute = false,
                            CreateNoWindow = true
                        }
                    };
                    _parserWorkerProcess.Start();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"パーサープロセスの起動に失敗しました: {ex.Message}");
            }
        }

        // アプリ終了時にワーカープロセスも確実に終了させる
        protected override void OnClosed(EventArgs e)
        {
            App.LogOperation("パーサーワーカーを終了 & セッション自動保存");
            try
            {
                // 自動復元が有効な場合、現在の状態を自動保存
                if (currentSettings != null && currentSettings.EnableAutoRestore)
                {
                    SaveAutoSession();
                }
            }
            catch { }

            try
            {
                if (_parserWorkerProcess != null)
                {
                    if (!_parserWorkerProcess.HasExited)
                    {
                        // プロセスに終了を試みる
                        _parserWorkerProcess.Kill();

                        // 終了したかどうかを一定時間（例: 2000ミリ秒）監視
                        bool exited = _parserWorkerProcess.WaitForExit(2000);
                        if (!exited || !_parserWorkerProcess.HasExited)
                        {
                            // 終了に失敗した場合はゾンビプロセスを防ぐため、FailFastで強制クラッシュさせる
                            Environment.FailFast("パーサーワーカープロセスの終了に失敗しました。ゾンビプロセス防止のためアプリケーションを強制終了します。");
                        }
                    }
                    _parserWorkerProcess.Dispose();
                    _parserWorkerProcess = null;
                }
            }
            catch (Exception ex) when (ex is not OutOfMemoryException && ex is not StackOverflowException)
            {
                // 万が一例外が発生した場合も、ゾンビプロセスを放置せず強制クラッシュさせる
                Environment.FailFast($"パーサーワーカー終了処理中に予期せぬエラーが発生しました: {ex.Message}", ex);
            }
            base.OnClosed(e);
        }

        // ワーカーの再起動用ヘルパー
        private void RestartParserWorker()
        {
            try
            {
                if (_parserWorkerProcess != null && !_parserWorkerProcess.HasExited)
                {
                    _parserWorkerProcess.Kill();
                    _parserWorkerProcess.Dispose();
                }
            }
            catch { }

            StartParserWorker();
        }
        // タブごとのファイル情報を保持する小クラス
        private class TabDocumentInfo
        {
            public ICSharpCode.AvalonEdit.TextEditor? Editor { get; set; }
            public string? FilePath { get; set; }
            // ★ 「変更なし」にしたとき（開いた・保存した・新規作成した時点）の本文を覚えておく
            //    文字を書き換えるたびにこの本文と比べ、同じに戻ったら「変更なし」にする（元に戻すで戻した場合など）
            //    （Editor を先に設定し、本文を入れた後で IsModified = false にすること）
            private bool _isModified;
            public bool IsModified
            {
                get => _isModified;
                set
                {
                    _isModified = value;
                    if (!value) OriginalText = Editor?.Text;
                }
            }
            public string? OriginalText { get; private set; }
            public Encoding? FileEncoding { get; set; }
            public TabItem? TabItem { get; set; }
        }

