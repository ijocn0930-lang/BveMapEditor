        // エディタごとの現在行ハイライトレンダラーを保持する辞書
        private readonly Dictionary<ICSharpCode.AvalonEdit.TextEditor, CurrentLineHighlightRenderer> _currentLineRenderers = new();
        private static Encoding DetectEncodingFromSample(byte[] sample)
        {
            if (sample == null || sample.Length == 0) return Encoding.Default;

            // 1. BOMのチェック
            if (sample.Length >= 3 && sample[0] == 0xEF && sample[1] == 0xBB && sample[2] == 0xBF)
            {
                // ★ BOM付きとして扱う（保存時に「元の文字コードを保持」で BOM付きのまま保存される）
                return new UTF8Encoding(true);
            }
            if (sample.Length >= 2 && sample[0] == 0xFF && sample[1] == 0xFE)
            {
                return Encoding.Unicode;
            }
            if (sample.Length >= 2 && sample[0] == 0xFE && sample[1] == 0xFF)
            {
                return Encoding.BigEndianUnicode;
            }
            if (sample.Length >= 4 && sample[0] == 0x00 && sample[1] == 0x00 && sample[2] == 0xFE && sample[3] == 0xFF)
            {
                return Encoding.UTF32;
            }

            // 2. UTF-8としての厳密な妥当性チェック
            // ★ 呼び出し側はファイル全体のバイト列を渡すこと（先頭だけだと誤判定するため）
            //    Utf8.IsValid は文字列を作らずに確認するので、大きいファイルでもメモリを余分に使わない
            if (System.Text.Unicode.Utf8.IsValid(sample))
            {
                return new UTF8Encoding(false); // UTF-8 として正しければ UTF-8（BOMなし）
            }
            // UTF-8として不正なバイトが含まれている場合はShift-JIS（CP932）等へフォールバック

            // 3. Shift-JIS (CP932) へのフォールバック
            try
            {
                Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
                return Encoding.GetEncoding(932);
            }
            catch
            {
                return Encoding.Default;
            }
        }
        /// <summary>
        /// 読み込んだ文字列の先頭に残った BOM（見えない文字 U+FEFF）を取り除く。
        /// BOM は文字コードの目印なので本文には含めない（保存時に文字コード側で付け直す）。
        /// </summary>
        private static string RemoveLeadingBom(string text)
        {
            if (!string.IsNullOrEmpty(text) && text[0] == '﻿')
            {
                return text.Substring(1);
            }
            return text;
        }
        private CurrentLineHighlightRenderer GetOrCreateCurrentLineRenderer(ICSharpCode.AvalonEdit.TextEditor editor)
        {
            if (editor?.TextArea?.TextView == null) return null!;

            // 1. 既に辞書に保持しており、かつTextViewに正しく含まれているか確認
            if (_currentLineRenderers.TryGetValue(editor, out var renderer) && renderer != null)
            {
                if (editor.TextArea.TextView.BackgroundRenderers.Contains(renderer))
                {
                    return renderer;
                }
            }

            // 2. 万が一、辞書の外でTextViewに同種のレンダラーが既に存在する場合はそれを再利用する
            var existing = editor.TextArea.TextView.BackgroundRenderers
                .OfType<CurrentLineHighlightRenderer>()
                .FirstOrDefault();

            if (existing != null)
            {
                _currentLineRenderers[editor] = existing;
                return existing;
            }

            // 3. どちらにもなければ新しく作成して追加する
            renderer = new CurrentLineHighlightRenderer(editor.TextArea);
            editor.TextArea.TextView.BackgroundRenderers.Add(renderer);
            _currentLineRenderers[editor] = renderer;

            return renderer;
        }
        private static async Task<string[]> ReadAllLinesWithAnsiFallbackAsync(string path)
        {
            byte[] bytes = await File.ReadAllBytesAsync(path);
            Encoding enc = DetectEncodingFromSample(bytes); // ★ ファイル全体で判定
            string text;
            try
            {
                text = enc.GetString(bytes);
            }
            catch
            {
                text = Encoding.Default.GetString(bytes);
            }
            text = RemoveLeadingBom(text); // ★ 先頭の BOM 文字を取り除く
            return text.Split(["\r\n", "\n"], StringSplitOptions.None);
        }

        private FileSystemWatcher? _fileSystemWatcher;

        public MainWindow()
        {
            isInitializing = true;
            InitializeComponent();
            // ★ 管理者権限で実行されているかをチェックし、セキュリティ低下の警告を表示
            CheckAdministratorWarning();
            // ★ パーサーワーカープロセス（別プロセス）を起動
            StartParserWorker();

            try
            {
                if (MenuStatusBar != null && MainStatusBar != null)
                {
                    MenuStatusBar.IsChecked = MainStatusBar.Visibility == Visibility.Visible;
                }
            }
            catch { }

            var editor = ActiveEditor ?? MapTextEditor;
            var underlineRenderer = new ErrorUnderlineRenderer(editor);
            editor.TextArea.TextView.BackgroundRenderers.Add(underlineRenderer);
            _underlineRenderers[editor] = underlineRenderer;

            if (editor.Document != null && editor.Document.UndoStack != null)
            {
                editor.Document.UndoStack.PropertyChanged += UndoStack_PropertyChanged;
            }

            MapHighlighter.InitializeHighlighting(editor);
            currentSettings = AppSettings.Load();
            ApplySettingsToEditor();
            ApplyWindowSettings();
            MapHighlighter.InitializeHighlighting(editor);

            var options = editor.Options;
            options.EnableEmailHyperlinks = false;
            options.EnableHyperlinks = false;
            options.EnableRectangularSelection = false;
            options.AllowScrollBelowDocument = true;
            options.ShowBoxForControlCharacters = false;
            options.ShowSpaces = false;
            options.ShowEndOfLine = false;

            if (editor != null)
            {
                editor.TextArea.TextEntered += MapTextEditor_TextEntered;
                editor.TextArea.TextEntering += MapTextEditor_TextEntering;
            }

            try
            {
                if (EditorTabControl != null && EditorTabControl.Items.Count > 0 && EditorTabControl.Items[0] is TabItem firstTab)
                {
                    var info = new TabDocumentInfo { Editor = MapTextEditor, FilePath = null, IsModified = false, FileEncoding = null, TabItem = firstTab };
                    firstTab.Tag = info;
                }
            }
            catch { }

            editor?.TextArea.KeyDown += (s, e) =>
            {
                try
                {
                    if (e.Key == Key.Insert)
                    {
                        if (currentSettings == null || currentSettings.AllowOverwriteToggle)
                        {
                            _isOverwriteMode = !_isOverwriteMode;
                            UpdateEditModeStatus();
                        }
                        e.Handled = true;
                    }
                }
                catch { }
            };

            editor?.PreviewKeyDown += (s, e) =>
            {
                try
                {
                    if (e.Key == Key.Insert)
                    {
                        if (currentSettings == null || currentSettings.AllowOverwriteToggle)
                        {
                            _isOverwriteMode = !_isOverwriteMode;
                            UpdateEditModeStatus();
                        }
                        e.Handled = true;
                    }
                }
                catch { }
            };

            if (editor?.Document != null && editor.Document.UndoStack != null)
            {
                editor.Document.UndoStack.PropertyChanged += UndoStack_PropertyChanged;
            }
            UpdateEditMenuState();

            editor?.TextArea.SelectionChanged += (s, e) =>
            {
                UpdateEditMenuState();
                UpdateCaretPositionStatus();
            };

            if (editor?.TextArea != null)
            {
                var highlightRenderer = new CurrentLineHighlightRenderer(editor.TextArea);
                editor.TextArea.TextView.BackgroundRenderers.Add(highlightRenderer);
                editor.TextArea.Caret.PositionChanged += (s, ea) =>
                {
                    editor.TextArea.TextView.InvalidateVisual();
                    UpdateCaretPositionStatus();
                };
            }

            UpdateCaretPositionStatus();
            UpdateEditModeStatus();

            // 初期表示用の即時パース実行
            RunSyntaxCheck();
            isInitializing = false;
        }
        // 管理者権限での実行を検知して警告するメソッド
        private void CheckAdministratorWarning()
        {
            try
            {
                var identity = WindowsIdentity.GetCurrent();
                var principal = new WindowsPrincipal(identity);
                if (principal.IsInRole(WindowsBuiltInRole.Administrator))
                {
                    App.LogOperation("警告: アプリケーションが管理者権限で実行されています。");
                    MessageBox.Show(
                        this,
                        "【セキュリティ警告】\n\n" +
                        "現在、BVE Map Editor が管理者権限で実行されています。\n" +
                        "管理者権限での実行はシステム全体のセキュリティリスクを高める可能性があります。\n" +
                        "特別な理由がない限り、通常の一般ユーザー権限で実行してください。",
                        "セキュリティの警告",
                        MessageBoxButton.OK,
                        MessageBoxImage.Warning);
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"管理者権限チェックエラー: {ex.Message}");
            }
        }
        private CompletionWindow? completionWindow;

        private void ApplyWindowSettings()
        {
            if (currentSettings.WindowWidth > 0 && currentSettings.WindowHeight > 0)
            {
                this.Width = currentSettings.WindowWidth;
                this.Height = currentSettings.WindowHeight;
            }
            if (currentSettings.IsMaximized)
            {
                this.WindowState = WindowState.Maximized;
            }
            if (ExplorerColumn != null && currentSettings.ExplorerPaneWidth > 0)
            {
                ExplorerColumn.Width = new GridLength(currentSettings.ExplorerPaneWidth);
            }
            try
            {
                MainStatusBar?.Visibility = currentSettings.ShowStatusBar ? Visibility.Visible : Visibility.Collapsed;
                MenuStatusBar?.IsChecked = currentSettings.ShowStatusBar;
            }
            catch { }
        }

        private void UndoStack_PropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
        {
            UpdateEditMenuState();
        }

        private void UpdateEditMenuState()
        {
            var editor = ActiveEditor;
            if (editor != null)
            {
                MenuUndo.IsEnabled = editor.Document?.UndoStack?.CanUndo ?? false;
                MenuRedo.IsEnabled = editor.Document?.UndoStack?.CanRedo ?? false;
            }
            else
            {
                MenuUndo.IsEnabled = false;
                MenuRedo.IsEnabled = false;
            }
            bool hasSelection = editor?.SelectionLength > 0;
            if (MenuCut != null) MenuCut.IsEnabled = hasSelection;
            if (MenuCopy != null) MenuCopy.IsEnabled = hasSelection;
            if (MenuPaste != null) MenuPaste.IsEnabled = Clipboard.ContainsText();
        }

        private async void ErrorListDataGrid_MouseDoubleClick(object sender, System.Windows.Input.MouseButtonEventArgs e)
        {
            if (ErrorListDataGrid.SelectedItem is not ParseError selectedError) return;

            string? targetPath = selectedError.FileName;
            if (!string.IsNullOrEmpty(targetPath) && !Path.IsPathRooted(targetPath))
            {
                string? currentPath = GetTabInfo(EditorTabControl?.SelectedItem as TabItem)?.FilePath ?? currentFilePath;
                string baseDirectory = !string.IsNullOrEmpty(currentPath)
                    ? Path.GetDirectoryName(currentPath) ?? string.Empty
                    : _currentRootFolderPath;
                targetPath = Path.GetFullPath(Path.Combine(baseDirectory, targetPath));
            }

            // ファイルが指定されており存在する場合、該当ファイルをタブで開く、またはアクティブにする
            if (!string.IsNullOrEmpty(targetPath) && File.Exists(targetPath))
            {
                string? activePath = GetTabInfo(EditorTabControl?.SelectedItem as TabItem)?.FilePath ?? currentFilePath;
                if (!string.Equals(activePath, targetPath, StringComparison.OrdinalIgnoreCase))
                {
                    await OpenFileAsync(targetPath);
                }
            }

            // エラー位置へのジャンプを実行
            JumpToErrorPosition(selectedError.Line, selectedError.Column);
        }
        // タブ切り替え時に ErrorList および波線を更新
        private void EditorTabControl_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            App.LogOperation("tab切り替え");
            try
            {
                var editor = ActiveEditor;
                if (editor != null)
                {
                    isInitializing = true;
                    MapHighlighter.InitializeHighlighting(editor);
                    try { editor.TextArea.TextEntered -= MapTextEditor_TextEntered; } catch { }
                    try { editor.TextArea.TextEntering -= MapTextEditor_TextEntering; } catch { }
                    editor.TextArea.TextEntered += MapTextEditor_TextEntered;
                    editor.TextArea.TextEntering += MapTextEditor_TextEntering;

                    GetOrCreateRenderer(editor);
                    // ★ 現在行ハイライトのレンダラーを確保・適用
                    GetOrCreateCurrentLineRenderer(editor);

                    string? targetPath = currentFilePath;
                    var activeInfo = GetTabInfo(EditorTabControl?.SelectedItem as TabItem);
                    if (activeInfo != null && !string.IsNullOrEmpty(activeInfo.FilePath))
                    {
                        targetPath = activeInfo.FilePath;
                    }
                    // ★ 文字コードをタブごとに切り替える（上書き保存で別タブの文字コードが使われるのを防ぐ）
                    if (activeInfo != null)
                    {
                        currentFileEncoding = activeInfo.FileEncoding;
                    }

                    try
                    {
                        if (editor.Document?.UndoStack != null)
                        {
                            editor.Document.UndoStack.PropertyChanged -= UndoStack_PropertyChanged;
                            editor.Document.UndoStack.PropertyChanged += UndoStack_PropertyChanged;
                        }
                        isInitializing = false;
                    }
                    catch
                    {
                        isInitializing = false;
                    }

                    // タブ切替時に即座にパース＆波線更新
                    // ★ タブ切替時は即時パースではなく、キャンセル処理付きの RunSyntaxCheck() を経由させることで競合を防ぐ
                    RunSyntaxCheck();
                    // ★ タブ切り替え直後にビューを強制再描画してハイライトを確実に表示
                    editor.TextArea.TextView.Redraw();
                    // ★ 追加：プロジェクト読み込み・復元完了後にタイトルバーを更新
                    UpdateTitle();
                    UpdateEncodingStatus();
                }
            }
            catch
            {
                isInitializing = false;
            }
        }

        private void JumpToErrorPosition(int lineNumber, int columnNumber)
        {
            App.LogOperation("ErrorListGridがクリックされました");
            try
            {
                if (lineNumber < 1) lineNumber = 1;
                if (columnNumber < 1) columnNumber = 1;
                var editor = ActiveEditor ?? MapTextEditor;
                if (editor == null) return;
                int totalLines = editor.Document.LineCount;
                if (lineNumber > totalLines) lineNumber = totalLines;
                DocumentLine line = editor.Document.GetLineByNumber(lineNumber);
                int offset = line.Offset + Math.Max(0, Math.Min(columnNumber - 1, line.Length));
                editor.Focus();
                editor.CaretOffset = offset;
                editor.ScrollToLine(lineNumber);
                editor.Select(line.Offset, line.Length);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"ジャンプ処理エラー: {ex.Message}");
            }
        }

        private async void MenuOpenFolder_Click(object sender, RoutedEventArgs e)
        {
            App.LogOperation("フォルダを開く");
            var openFolderDialog = new OpenFolderDialog
            {
                Title = "プロジェクトフォルダを開く"
            };
            if (openFolderDialog.ShowDialog() == true)
            {
                string folderPath = openFolderDialog.FolderName;
                _currentRootFolderPath = openFolderDialog.FolderName;
                _currentBveepFilePath = string.Empty;
                SetupFileSystemWatcher(folderPath);

                var loadingWindow = new LoadingWindow
                {
                    Owner = this
                };
                loadingWindow.Show();
                this.IsEnabled = false;
                Mouse.OverrideCursor = Cursors.Wait;
                try
                {
                    FileSystemNode? rootNode = await ScanDirectoryAsync(folderPath);
                    LoadFileSystemToTreeView(rootNode);
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"フォルダの読み込み中にエラーが発生しました。\n{ex.Message}", "エラー", MessageBoxButton.OK, MessageBoxImage.Error);
                }
                finally
                {
                    this.IsEnabled = true;
                    Mouse.OverrideCursor = null;
                    loadingWindow.Close();
                }
            }
        }

        private void MenuNew_Click(object sender, ExecutedRoutedEventArgs e)
        {
            App.LogOperation("新規作成");
            // ★ 新規作成は「無題」のタブを追加する。今開いているタブはそのまま残す
            //    （以前は今のタブの中身を消していたため、開いていたファイルが閉じられていた）
            if (EditorTabControl == null) return;

            var editor = new ICSharpCode.AvalonEdit.TextEditor();
            InitializeEditor(editor); // 共通初期化（フォント・ハイライト・右クリックメニューなど）

            var tab = new TabItem { Header = "無題", Content = editor };
            var info = new TabDocumentInfo { Editor = editor, FilePath = null, IsModified = false, FileEncoding = null, TabItem = tab };
            tab.Tag = info;
            EditorTabControl.Items.Add(tab);
            EditorTabControl.SelectedItem = tab; // タブ切替の処理で、文字コード・タイトル・波線などが更新される
        }

        private void MenuExit_Click(object sender, RoutedEventArgs e)
        {
            Close();
        }

        private void UpdateTitle()
        {
            App.LogOperation("タイトル更新");
            var active = EditorTabControl != null && EditorTabControl.SelectedItem is TabItem ti ? global::BveMapEditor.MainWindow.GetTabInfo(ti) : null;
            string fileName;
            bool modified = false;
            if (active != null)
            {
                fileName = string.IsNullOrEmpty(active.FilePath) ? "無題" : Path.GetFileName(active.FilePath);
                modified = active.IsModified;
                currentFilePath = active.FilePath;
            }
            else
            {
                fileName = string.IsNullOrEmpty(currentFilePath) ? "無題" : Path.GetFileName(currentFilePath);
                modified = isModified;
            }
            Title = $"BVE Map Editor - {fileName}{(modified ? " *" : "")}";
        }

        private void MenuAbout_Click(object sender, RoutedEventArgs e)
        {
            App.LogOperation("情報メニューがクリックされました。");
            var aboutWindow = new AboutWindow
            {
                Owner = this
            };
            aboutWindow.ShowDialog();
        }

        private ErrorUnderlineRenderer GetOrCreateRenderer(ICSharpCode.AvalonEdit.TextEditor editor)
        {
            if (_underlineRenderers.TryGetValue(editor, out var renderer)) return renderer;
            renderer = new ErrorUnderlineRenderer(editor);
            if (!editor.TextArea.TextView.BackgroundRenderers.Contains(renderer))
            {
                editor.TextArea.TextView.BackgroundRenderers.Add(renderer);
            }
            _underlineRenderers[editor] = renderer;
            return renderer;
        }

        /// <summary>
        /// 選択されたエラー行の情報をクリップボードにコピーする
        /// </summary>
        private void ErrorMenuCopy_Click(object sender, RoutedEventArgs e)
        {
            if (ErrorListDataGrid.SelectedItem is not ParseError item) return;

            string copyText = $"[{item.Level}] ファイル: {item.FileName} (行:{item.Line}, 列:{item.Column}) - {item.Message}";
            Clipboard.SetText(copyText);
            StatusText.Text = "選択したエラー情報をクリップボードにコピーしました。";
        }

        /// <summary>
        /// ファイルツリー（TreeView）で該当ファイルのエントリを自動選択する
        /// </summary>
        private void ErrorMenuSelectInTree_Click(object sender, RoutedEventArgs e)
        {
            if (ErrorListDataGrid.SelectedItem is not ParseError item) return;
            if (string.IsNullOrEmpty(item.FileName)) return;

            string targetPath = item.FileName;
            // 相対パスの場合はルートフォルダからの絶対パスに変換
            if (!Path.IsPathRooted(targetPath) && !string.IsNullOrEmpty(_currentRootFolderPath))
            {
                targetPath = Path.Combine(_currentRootFolderPath, targetPath);
            }

            if (!File.Exists(targetPath))
            {
                MessageBox.Show($"対象のファイルが見つかりません:\n{targetPath}", "ファイル未検出", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            // FileExplorerPaine.cs 内にある既存のヘルパーメソッドをそのまま呼び出し
            if (SelectTreeViewItemByPath(FileExplorerTreeView, targetPath))
            {
                StatusText.Text = $"ファイルツリーで '{Path.GetFileName(targetPath)}' を選択しました。";
            }
            else
            {
                MessageBox.Show("現在開いているプロジェクトフォルダ内に、このファイルに対応するツリー項目が見つかりませんでした。", "通知", MessageBoxButton.OK, MessageBoxImage.Information);
            }
        }

        /// <summary>
        /// OSのエクスプローラーを起動し、該当ファイルが選択された状態で表示する
        /// </summary>
        private void ErrorMenuOpenInExplorer_Click(object sender, RoutedEventArgs e)
        {
            if (ErrorListDataGrid.SelectedItem is not ParseError item) return;
            if (string.IsNullOrEmpty(item.FileName)) return;

            string targetPath = item.FileName;
            if (!Path.IsPathRooted(targetPath) && !string.IsNullOrEmpty(_currentRootFolderPath))
            {
                targetPath = Path.Combine(_currentRootFolderPath, targetPath);
            }

            if (!File.Exists(targetPath))
            {
                MessageBox.Show($"対象のファイルが見つかりません:\n{targetPath}", "ファイル未検出", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            try
            {
                // /select 引数を使うことで、エクスプローラー上でそのファイルにフォーカスが当たった状態で開ける
                Process.Start(new ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{targetPath}\"",
                    UseShellExecute = true
                });
                StatusText.Text = "エクスプローラーでファイルを表示しました。";
            }
            catch (Exception ex)
            {
                MessageBox.Show($"エクスプローラーを開けませんでした: {ex.Message}", "エラー", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }
        /// <summary>
        /// 外部のHTMLヘルプファイルをブラウザで開く
        /// </summary>
        private void ErrorMenuSearchHelp_Click(object sender, RoutedEventArgs e)
        {
            if (ErrorListDataGrid.SelectedItem is not ParseError item) return;

            // Null安全対策として、あらかじめ string.Empty で確実に非null化しておく
            string msg = item.Message ?? string.Empty;
            string fileName = item.FileName ?? string.Empty;

            // 1. エラー内容に応じて開くHTMLファイル名を決定
            string htmlFileName = "default.html";

            if (msg.Contains("ストラクチャー") || msg.Contains("Structure") || msg.Contains("キー"))
            {
                htmlFileName = "structure.html";
            }
            else if (msg.Contains("サウンド") || msg.Contains("Sound") || msg.Contains("キー"))
            {
                htmlFileName = "sound.html";
            }
            else if (msg.Contains("ステーション") || msg.Contains("Station") || msg.Contains("キー"))
            {
                htmlFileName = "station.html";
            }
            else if (msg.Contains("ファイル") || msg.Contains("見つかりません") || msg.Contains("path"))
            {
                htmlFileName = "file.html";
            }
            else if (msg.Contains("Put") || msg.Contains("引数にパラメータが指定されていません。"))
            {
                htmlFileName = "Put.html";
            }
            else if (msg.Contains("Section.SetSpeedLimit または Signal.SpeedLimit が複数記述されています。この構文は信号指示速度のため、マップファイル全体で1つしか記述できません。"))
            {
                htmlFileName = "SignalLimitSection.html";
            }
            string helpDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Help");
            string htmlPath = Path.Combine(helpDir, htmlFileName);

            if (!File.Exists(htmlPath))
            {
                htmlPath = Path.Combine(helpDir, "default.html");
            }

            try
            {
                if (File.Exists(htmlPath))
                {
                    // 3. 外部HTMLのテンプレートを読み込む
                    string htmlContent = File.ReadAllText(htmlPath, Encoding.UTF8);

                    // 4. HTML内のプレースホルダー（目印）を実際の値に置換する
                    htmlContent = htmlContent.Replace("__MSG__", System.Net.WebUtility.HtmlEncode(msg));
                    htmlContent = htmlContent.Replace("__LINE__", item.Line.ToString());
                    htmlContent = htmlContent.Replace("__FILE__", System.Net.WebUtility.HtmlEncode(fileName));

                    // 5. 一時ファイルとして書き出してブラウザで開く
                    string tempHtmlPath = Path.Combine(Path.GetTempPath(), "BveMapEditor_ErrorHelp.html");
                    File.WriteAllText(tempHtmlPath, htmlContent, Encoding.UTF8);

                    Process.Start(new ProcessStartInfo(tempHtmlPath) { UseShellExecute = true });
                    StatusText.Text = "外部ヘルプをブラウザで開きました。";
                }
                else
                {
                    // HTMLファイルがない場合はGoogle検索にフォールバック
                    string query = $"BVE Map Editor {msg}";
                    string url = $"https://www.google.com/search?q={Uri.EscapeDataString(query)}";
                    Process.Start(new ProcessStartInfo(url) { UseShellExecute = true });
                    StatusText.Text = "Google検索をブラウザで開きました。";
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"ヘルプの表示に失敗しました: {ex.Message}", "エラー", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }
        private void ErrorMenuAskGemini_Click(object sender, RoutedEventArgs e)
        {
            if (ErrorListDataGrid.SelectedItem is not ParseError item) return;

            string prompt = $"BVE Map Editorの開発・マップ制作において、以下の構文エラー（警告）が発生しました。\n" +
                            $"正しい構文の修正方法や原因について教えてください。\n\n" +
                            $"--- エラー詳細 ---\n" +
                            $"・ファイル名: {item.FileName}\n" +
                            $"・発生位置: 行 {item.Line}, 列 {item.Column}\n" +
                            $"・レベル: {item.Level}\n" +
                            $"・メッセージ: {item.Message}\n";

            Clipboard.SetText(prompt);

            try
            {
                Process.Start(new ProcessStartInfo("https://gemini.google.com/") { UseShellExecute = true });
                StatusText.Text = "エラー情報をクリップボードにコピーし、Geminiを開きました（Ctrl+Vで貼り付けて質問できます）。";
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Geminiを開けませんでした: {ex.Message}", "エラー", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }
        /// <summary>
        /// ErrorListDataGridの右クリックメニューが開かれる直前のイベント
        /// </summary>
        private void ErrorListDataGrid_ContextMenuOpening(object sender, System.Windows.Controls.ContextMenuEventArgs e)
        {
            // 行が選択されていない場合はメニューを表示しない
            if (ErrorListDataGrid.SelectedItem == null)
            {
                e.Handled = true;
                return;
            }

            // 選択されたエラー項目に応じてファイル関連メニューの有効/無効を動的に切り替える
            if (ErrorListDataGrid.SelectedItem is ParseError item)
            {
                bool hasValidFile = false;

                if (!string.IsNullOrEmpty(item.FileName))
                {
                    string targetPath = item.FileName;
                    // 相対パスの場合はルートフォルダからの絶対パスに変換
                    if (!Path.IsPathRooted(targetPath) && !string.IsNullOrEmpty(_currentRootFolderPath))
                    {
                        targetPath = Path.Combine(_currentRootFolderPath, targetPath);
                    }

                    // ファイルが実際に存在するか確認
                    hasValidFile = File.Exists(targetPath);
                }

                // ファイル名がない、またはファイルが存在しない場合はグレーアウトする
                MenuErrorSelectInTree.IsEnabled = hasValidFile;
                MenuErrorOpenInExplorer.IsEnabled = hasValidFile;
            }
        }
        private void UpdateEncodingStatus()
        {
            Dispatcher.Invoke(() =>
            {
                if (FileEncodingText == null) return;
                try
                {
                    Encoding? enc = null;

                    // アクティブなタブの情報を取得
                    var activeInfo = GetTabInfo(EditorTabControl?.SelectedItem as TabItem);
                    if (activeInfo != null)
                    {
                        enc = activeInfo.FileEncoding;
                    }
                    else
                    {
                        enc = currentFileEncoding;
                    }

                    if (enc != null)
                    {
                        // エンコーディング名を見やすく整形
                        string encName = enc.WebName.ToLower() switch
                        {
                            "utf-8" => (enc is UTF8Encoding utf8 && utf8.GetPreamble().Length > 0) ? "UTF-8 (BOM付)" : "UTF-8",
                            "shift_jis" or "sjis" or "cp932" => "Shift-JIS",
                            "utf-16le" or "unicode" => "UTF-16 LE",
                            "utf-16be" => "UTF-16 BE",
                            _ => enc.EncodingName
                        };
                        FileEncodingText.Text = encName;
                    }
                    else
                    {
                        // デフォルト（無題タブなど）
                        FileEncodingText.Text = "UTF-8";
                    }
                }
                catch
                {
                    FileEncodingText.Text = string.Empty;
                }
            });
        }
        // パイプ通信経由でパースを実行するメソッド
        public async Task<ParseResponse> ParseViaPipeAsync(string routeFilePath, string routeText, Dictionary<string, string> unsavedTexts)
        {
            return await Task.Run(async () =>
            {
                // ★ 失敗した理由を覚えておき、最後のエラーメッセージに付ける（原因を調べるため）
                var failureReasons = new List<string>();
                for (int retry = 0; retry < 2; retry++)
                {
                    try
                    {
                        using var clientStream = new NamedPipeClientStream(".", PipeName, PipeDirection.InOut, PipeOptions.Asynchronous);
                        clientStream.Connect(1000);

                        if (!GetNamedPipeServerProcessId(clientStream.SafePipeHandle, out uint serverProcessId))
                        {
                            throw new UnauthorizedAccessException("パイプサーバーのプロセスIDを取得できませんでした。");
                        }

                        using var writer = new StreamWriter(clientStream, Encoding.UTF8, leaveOpen: true);
                        using var reader = new StreamReader(clientStream, Encoding.UTF8, leaveOpen: true);

                        // ★ 要求オブジェクトの構築
                        var request = new BveSemanticAnalyzer.ParseRequest
                        {
                            RouteFilePath = routeFilePath,
                            RouteText = routeText,
                            UnsavedTexts = unsavedTexts
                        };

                        string jsonRequest = JsonSerializer.Serialize(request);
                        writer.WriteLine(jsonRequest);
                        writer.Flush();

                        string? jsonResponse = reader.ReadLine();
                        if (!string.IsNullOrEmpty(jsonResponse))
                        {
                            return JsonSerializer.Deserialize<ParseResponse>(jsonResponse) ?? new ParseResponse();
                        }
                        failureReasons.Add($"試行{retry + 1}: ワーカーから空の返事が返りました");
                    }
                    catch (Exception ex)
                    {
                        failureReasons.Add($"試行{retry + 1}: {ex.GetType().Name}: {ex.Message}");
                        App.LogOperation($"パイプ通信エラー (試行 {retry + 1}): {ex.Message}");
                        if (retry == 0)
                        {
                            RestartParserWorker();
                            await Task.Delay(500);
                        }
                    }
                }

                return new ParseResponse
                {
                    Errors = new List<ParseError>
                    {
                        new ParseError
                        {
                            Level = "エラー",
                            Line = 1,
                            Column = 1,
                            Message = "マップパーサープロセス（ワーカー）との通信に失敗しました。構文チェックを実行できません。" +
                                      (failureReasons.Count > 0 ? $"（詳細: {string.Join(" / ", failureReasons)}）" : string.Empty)
                        }
                    }
                };
            });
        }

        /// <summary>
        /// (3) 統合された単一の構文チェック開始メソッド
        /// </summary>
        /// <param name="isImmediate">デバウンス（遅延）挟まず即時実行するかどうか</param>
        private void RunSyntaxCheck(bool isImmediate = false)
        {
            if (isLoading || isInitializing) return;

            _syntaxCts?.Cancel();
            _syntaxCts = new CancellationTokenSource();
            var token = _syntaxCts.Token;

            Task.Run(async () =>
            {
                if (!isImmediate)
                {
                    try
                    {
                        await Task.Delay(SyntaxDebounceDelay, token).ConfigureAwait(false);
                    }
                    catch (TaskCanceledException)
                    {
                        return;
                    }
                }

                if (token.IsCancellationRequested) return;

                string activeFilePath = string.Empty;
                string activeText = string.Empty;
                var unsavedTexts = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                ICSharpCode.AvalonEdit.TextEditor? activeEditor = null;

                // GUIスレッドから現在の情報・未保存テキストを一括収集
                await Dispatcher.InvokeAsync(() =>
                {
                    activeEditor = ActiveEditor ?? MapTextEditor;
                    activeText = activeEditor?.Text ?? string.Empty;

                    var activeInfo = GetTabInfo(EditorTabControl?.SelectedItem as TabItem);
                    activeFilePath = activeInfo?.FilePath ?? currentFilePath ?? string.Empty;

                    if (EditorTabControl != null)
                    {
                        foreach (var item in EditorTabControl.Items)
                        {
                            if (item is TabItem ti && GetTabInfo(ti) is TabDocumentInfo info)
                            {
                                if (!string.IsNullOrEmpty(info.FilePath) && info.Editor != null)
                                {
                                    unsavedTexts[info.FilePath] = info.Editor.Text;
                                }
                            }
                        }
                    }
                });

                if (token.IsCancellationRequested) return;

                // ★ 子タブであれば親の対応関係（_childToParentMap）をたどってルートのパスとテキストを取得する
                string routeFilePath = activeFilePath;
                string routeText = activeText;
                var visitedRouteCheck = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                while (!string.IsNullOrEmpty(routeFilePath) && _childToParentMap.TryGetValue(routeFilePath, out var parentPath))
                {
                    if (!visitedRouteCheck.Add(routeFilePath)) break; // 循環回避
                    routeFilePath = parentPath;
                }

                // ルートテキストの決定（未保存辞書にあれば優先、なければファイルから読み込み）
                if (routeFilePath != activeFilePath && !string.IsNullOrEmpty(routeFilePath))
                {
                    if (unsavedTexts.TryGetValue(routeFilePath, out var unsavedRouteText))
                    {
                        routeText = unsavedRouteText;
                    }
                    else if (File.Exists(routeFilePath))
                    {
                        try
                        {
                            routeText = File.ReadAllText(routeFilePath);
                        }
                        catch { }
                    }
                }

                try
                {
                    // パイプ経由でルートから解析を実行
                    ParseResponse response = await ParseViaPipeAsync(routeFilePath, routeText, unsavedTexts);
                    if (token.IsCancellationRequested) return;

                    // 受け取った「子->親」対応関係をローカルに更新・保存
                    foreach (var kvp in response.ParentMap)
                    {
                        _childToParentMap[kvp.Key] = kvp.Value;
                    }

                    List<ParseError> allErrors = response.Errors;

                    await Dispatcher.InvokeAsync(() =>
                    {
                        // エラー一覧には全件を表示
                        ErrorListDataGrid.ItemsSource = null;
                        ErrorListDataGrid.ItemsSource = allErrors;

                        // 波線にはアクティブなタブ（ファイル）のエラーだけを渡して描画
                        if (activeEditor != null)
                        {
                            string NormalizePath(string p)
                            {
                                try { return Path.GetFullPath(p); } catch { return p; }
                            }

                            var targetErrors = string.IsNullOrEmpty(activeFilePath)
                                ? allErrors
                                : allErrors.Where(e =>
                                {
                                    // FileName が空のエラーは、ルートファイルのもの
                                    string owner = string.IsNullOrEmpty(e.FileName) ? routeFilePath : e.FileName;
                                    return string.Equals(NormalizePath(owner), NormalizePath(activeFilePath), StringComparison.OrdinalIgnoreCase);
                                }).ToList();

                            // ★ 絞り込んだエラーを波線の描画に渡す（以前は渡していなかったため波線が出なかった）
                            GetOrCreateRenderer(activeEditor).SetErrors(targetErrors);
                        }
                    });
                }
                catch (Exception ex)
                {
                    var exceptionErrors = new List<ParseError>
                    {
                        new ParseError { Line = 1, Column = 1, Message = $"構文チェック中にエラーが発生しました: {ex.Message}" }
                    };
                    await Dispatcher.InvokeAsync(() =>
                    {
                        ErrorListDataGrid.ItemsSource = exceptionErrors;
                    });
                }
            }, token);
        }
    }
}