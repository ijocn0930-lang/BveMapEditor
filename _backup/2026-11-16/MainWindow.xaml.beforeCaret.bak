<Window x:Class="BveMapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="BVE Map Editor" Height="600" Width="1050"
        MinWidth="600" MinHeight="400"
        Closing="OnClosing">
    <!-- キーボードショートカット用のコマンドバインディング -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="MenuNew_Click" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="MenuOpen_Click" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="MenuSave_Click" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="MenuSaveAs_Click" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="MenuExit_Click" />
        <!-- ★ Ctrl+F で検索ウィンドウを開く（メニューの「Ctrl+F」は表示だけで、キーにつながっていなかった） -->
        <CommandBinding Command="ApplicationCommands.Find" Executed="MenuSearchCommand_Executed" />
    </Window.CommandBindings>
    <!-- ★ Ctrl+Shift+S で「名前を付けて保存」（WPF の SaveAs には決まったキーがないため、ここでつなぐ） -->
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.SaveAs" Gesture="Ctrl+Shift+S" />
    </Window.InputBindings>

    <DockPanel>
        <!-- 画面上部のメニューバー -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="4">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" Command="ApplicationCommands.New" />
                <MenuItem Header="ファイルを開く(_O)..." Command="ApplicationCommands.Open" />
                <MenuItem Header="フォルダを開く(_F)..." Click="MenuOpenFolder_Click" />
                <Separator />
                <MenuItem Header="上書き保存(_S)" Command="ApplicationCommands.Save" />
                <MenuItem Header="名前を付けて保存(_A)..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem x:Name="LoadExpPane" Header="開く(エクスプローラーペイン)" Click="MenuOpenBveep_Click"/>
                <MenuItem x:Name="SaveExpPane" Header="上書き保存(エクスプローラーペイン)" Click="MenuSaveBveep_Click"/>
                <MenuItem x:Name="SaveAsExpPane" Header="別名で保存(エクスプローラーペイン)" Click="MenuSaveAsBveep_Click" />
                <MenuItem Header="エクスプローラーペインを空にする" Click="MenuClearExplorerPane_Click"/>
                <Separator />
                <!--プロジェクト（タブとエクスプローラーペイン保持ファイル）-->
                <MenuItem Header="プロジェクトを開く" Click="MenuOpenProject_Click"/> <!--仮タブ含むプロジェクトを開く-->
                <MenuItem Header="プロジェクトを上書き保存" Click="MenuSaveProject_Click"/> <!--仮タブ含むプロジェクトを保存-->
                <MenuItem Header="プロジェクトを別名で保存" Click="MenuSaveProjectAs_Click"/> <!--仮タブ含むプロジェクトを名前を付けて保存-->
                <Separator />
                <!-- ★ (2026-11-15) 閉じれるタブがない（空の「無題」タブ1つだけ）ときはグレーアウトする（MainWindow.xaml.cs の UpdateTabCloseState） -->
                <MenuItem x:Name="MenuCloseTab" Header="タブを閉じる" Click="MenuCloseTab_Click" />
                <MenuItem x:Name="MenuCloseAllTabs" Header="すべてのタブを閉じる" Click="MenuCloseAllTabs_Click" />
                <MenuItem Header="終了(_X)" Command="ApplicationCommands.Close" />
                <!--<MenuItem Header="Crash" Click="Crash_Click" />--><!--デバッグするならコメントアウト解除-->
            </MenuItem>
            <!-- ★ (2026-11-15) 開いたときに「貼り付け」などを押せるか調べ直す（EditMenu.cs の EditMenu_SubmenuOpened） -->
            <MenuItem Header="編集" SubmenuOpened="EditMenu_SubmenuOpened">
                <MenuItem x:Name="MenuUndo" Header="変更を戻す(_U)" Click="MenuUndo_Click" InputGestureText="Ctrl+Z" IsEnabled="False" />
                <MenuItem x:Name="MenuRedo" Header="やり直す(_R)" Click="MenuRedo_Click" InputGestureText="Ctrl+Y" IsEnabled="False" />
                <MenuItem x:Name="MenuCut" Header="切り取り(_T)" Click="MenuCut_Click" IsEnabled="False" />
                <MenuItem x:Name="MenuCopy" Header="コピー(_C)" Click="MenuCopy_Click" IsEnabled="False" />
                <MenuItem x:Name="MenuPaste" Header="貼り付け(_P)" Click="MenuPaste_Click" />
                <Separator />
                <MenuItem x:Name="MenuWordWrap" Header="右端で折り返す(_W)" IsCheckable="True" Click="MenuWordWrap_Click" />
                <MenuItem Header="すべて選択(_A)" Click="MenuSelectAll_Click" InputGestureText="Ctrl+A" />
                <Separator />
                <MenuItem Header="検索(_F)..." Click="MenuSearch_Click" InputGestureText="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="設定">
                <MenuItem Header="フォント設定..." Click="MenuFontSettings_Click" />
                <MenuItem x:Name="MenuAutoCompletion" 
                  Header="自動補完を有効にする(_A)" 
                  IsCheckable="True" 
                  Click="MenuAutoCompletion_Click" />
                <!-- ★ キーの自動補完のオン・オフ -->
                <MenuItem x:Name="MenuKeyCompletion"
                  Header="キーの自動補完を有効にする(_K)"
                  IsCheckable="True"
                  Click="MenuKeyCompletion_Click" />
                    <MenuItem x:Name="MenuAllowOverwriteToggle" Header="Insertキーで上書き切替を許可" IsCheckable="True" Click="MenuAllowOverwriteToggle_Click" />
                    <MenuItem x:Name="MenuStatusBar" Header="ステータスバーを表示" IsCheckable="True" Click="MenuStatusBar_Click" />
                <Separator />
                <MenuItem Header="テーマ(_T)">
                    <MenuItem x:Name="MenuThemeSystem" Header="システム既定(_S)" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="System" />
                    <MenuItem x:Name="MenuThemeLight" Header="ライト(_L)" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="Light" />
                    <MenuItem x:Name="MenuThemeDark" Header="ダーク(_D)" IsCheckable="True" Click="ThemeMenuItem_Click" Tag="Dark" />
                </MenuItem>
                <Separator />
                <MenuItem Header="詳細設定(_D)..." Click="MenuDetailSettings_Click" />
            </MenuItem>
            <MenuItem Header="デバッグ(_D)">
                <MenuItem Header="BVEでデバッグ実行(_R)" Click="MenuDebugRun_Click" />
                <MenuItem Header="QuickMapViewerを実行(_R)" Click="MenuDebugRunQMV_Click" />

            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="BVE公式サイト(_B)" Click="MenuBveSite_Click" />
                <MenuItem Header="BVE 公開ガイドライン" Click="MenuBveSiteGuide_Click" />
                <MenuItem Header="BVE ファイル書式" Click="MenuBveformat_Click" />
                <Separator />
                <MenuItem Header="バージョン情報(_A)..." Click="MenuAbout_Click" />
            </MenuItem>
        </Menu>
        <!-- ウィンドウ下部のステータスバー -->
        <StatusBar DockPanel.Dock="Bottom" x:Name="MainStatusBar" Background="#F5F5F5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="準備完了" />
            </StatusBarItem>
            <StatusBarItem>
                <!-- ★ 追加: 文字コード表示用 -->
                <TextBlock x:Name="FileEncodingText" Text="UTF-8" Margin="0,0,15,0" VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="EditModeText" Text="挿入" Margin="8,0" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CaretPositionText" Text="" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <!-- 全体を左右に分割 (左: エクスプローラー, 右: 編集・エラーエリア) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="230" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. 左側: エクスプローラーペイン -->
            <DockPanel Grid.Column="0" LastChildFill="True" Background="#FFF5F5F5">
                <TextBlock Text="エクスプローラー" DockPanel.Dock="Top" Background="#FFE0E0E0" Padding="8,5" FontWeight="Bold"/>
                <TreeView x:Name="FileExplorerTreeView" Margin="2" SelectedItemChanged="FileExplorerTreeView_SelectedItemChanged" MouseDoubleClick="FileExplorerTreeView_MouseDoubleClick"
                          ContextMenuOpening="FileExplorerTreeView_ContextMenuOpening">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <EventSetter Event="MouseRightButtonDown" Handler="TreeViewItem_MouseRightButtonDown"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="ExplorerContextMenu">
                            <MenuItem Header="エクスプローラーで開く" Click="MenuOpenInExplorer_Click"/>
                            <Separator/>
                            <MenuItem Header="新規テキストファイル (*.txt)" Click="MenuNewTextFile_Click"/>
                            <MenuItem Header="名前の変更" Click="ExplorerPaneMenuRename_Click"/>
                            <Separator/>
                            <MenuItem Header="コピー" Click="ExplorerPaneMenuCopy_Click"/>
                            <MenuItem Header="貼り付け" Click="ExplorerPaneMenuPaste_Click"/>
                            <Separator/>
                            <MenuItem Header="再読み込み" Click="MenuRefreshTree_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FFDDDDDD" />
            <!-- 2. 右側: メインエリア（上下分割：エディタ ＆ エラー一覧） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <!-- ★ ContextMenuOpening: エディタを右クリックしたとき、その行のエラーの「修正の候補」をメニューの先頭に出す（ErrorFix.cs） -->
                <TabControl x:Name="EditorTabControl" Grid.Row="0" MinHeight="120" SelectionChanged="EditorTabControl_SelectionChanged" ContextMenuOpening="EditorTabControl_ContextMenuOpening" >
                    <!-- ★ タブ名をそのまま表示する。
                         標準のままだとタブ名の「_」がキーボードショートカットの印として扱われ、表示から消えてしまう（例: map_01.txt → map01.txt）。
                         TextBlock で表示すると「_」がそのまま表示される。コードで追加するタブにも自動で効く -->
                    <TabControl.Resources>
                        <!-- ★ 水平スクロールバーを常に表示する（コードで追加するタブのエディタにも効く）
                             標準（Auto）だと、上下にスクロールして見えている行の長さが変わるたびに、
                             水平スクロールバーが出たり消えたりして画面がガタガタしていた。
                             「右端で折り返す」が有効なときは横スクロールが不要なので出さない -->
                        <Style TargetType="avalonEdit:TextEditor">
                            <Setter Property="HorizontalScrollBarVisibility" Value="Visible" />
                            <Style.Triggers>
                                <Trigger Property="WordWrap" Value="True">
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <!-- ★ (2026-11-15) タブ名の横に × ボタンを付ける。タブ名の右クリックメニューと、マウスの真ん中ボタンでも閉じられる。
                                         どれも未保存なら「保存しますか?」を出す（MainWindow.xaml.cs の CloseTab） -->
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Background="Transparent" MouseUp="TabHeader_MouseUp">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu Opened="TabHeaderMenu_Opened">
                                                    <MenuItem Header="閉じる" Tag="NeedClosable" Click="TabMenuClose_Click" />
                                                    <MenuItem Header="ほかのタブをすべて閉じる" Tag="NeedOthers" Click="TabMenuCloseOthers_Click" />
                                                    <MenuItem Header="すべてのタブを閉じる" Tag="NeedClosable" Click="TabMenuCloseAll_Click" />
                                                    <Separator />
                                                    <MenuItem Header="ファイルのパスをコピー" Tag="NeedPath" Click="TabMenuCopyPath_Click" />
                                                    <MenuItem Header="ファイルの場所を開く" Tag="NeedPath" Click="TabMenuOpenFolder_Click" />
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Content="×" ToolTip="タブを閉じる" Click="TabCloseButton_Click"
                                                    Tag="TabClose" Loaded="TabCloseButton_Loaded"
                                                    Focusable="False" Margin="6,0,0,0" Padding="3,0" FontSize="11"
                                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="無題" IsSelected="True">
                        <avalonEdit:TextEditor x:Name="MapTextEditor"
                                               MinHeight="120"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               ShowLineNumbers="True"
                                               TextChanged="MapTextEditor_TextChanged"
                                               PreviewMouseWheel="MapTextEditor_PreviewMouseWheel">
                            <!-- ★ ContextMenuService の添付プロパティを使用する -->
                            <ContextMenuService.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="元に戻す(_U)" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" />
                                    <MenuItem Header="やり直す(_R)" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" />
                                    <Separator />
                                    <MenuItem Header="切り取り(_T)" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" />
                                    <MenuItem Header="コピー(_C)" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="貼り付け(_P)" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="すべて選択(_A)" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                                </ContextMenu>
                            </ContextMenuService.ContextMenu>
                        </avalonEdit:TextEditor>
                    </TabItem>
                </TabControl>
                <!-- MapTextEditor と ErrorListDataGrid の間に配置する水平スプリッター -->
                <GridSplitter Grid.Row="0" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="#FFDDDDDD" ShowsPreview="True"  ResizeDirection="Rows" />
                <!-- 下部: エラー一覧 DataGrid -->
                <DataGrid x:Name="ErrorListDataGrid"  Grid.Row="1" AutoGenerateColumns="False"  IsReadOnly="True"   MouseDoubleClick="ErrorListDataGrid_MouseDoubleClick" ContextMenuOpening="ErrorListDataGrid_ContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <!-- ★ 修正の候補（中身はエラーに合わせて ErrorFix.cs の FillErrorFixMenu で作る） -->
                            <MenuItem x:Name="MenuErrorFix" Header="修正の候補" />
                            <Separator />
                            <MenuItem Header="行のコピー" Click="ErrorMenuCopy_Click" InputGestureText="Ctrl+C" />
                            <!-- ★ (2026-11-16) エラー一覧の全部の行をタブ区切りでコピー（Excel・メモ帳に貼れる） -->
                            <MenuItem Header="すべてコピー" Click="ErrorMenuCopyAll_Click" />
                            <Separator />
                            <MenuItem x:Name="MenuErrorSelectInTree" Header="ファイルツリーでこのファイルを選択" Click="ErrorMenuSelectInTree_Click" />
                            <MenuItem x:Name="MenuErrorOpenInExplorer" Header="エクスプローラーでファイルを表示" Click="ErrorMenuOpenInExplorer_Click" />
                            <Separator />
                            <MenuItem Header="このエラーについて検索・ヘルプを表示" Click="ErrorMenuSearchHelp_Click" />
                            <MenuItem Header="Geminiに修正を依頼する" Click="ErrorMenuAskGemini_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="レベル" Binding="{Binding Level}" Width="40" />
                        <DataGridTextColumn Header="行" Binding="{Binding Line}" Width="60" />
                        <DataGridTextColumn Header="列" Binding="{Binding Column}" Width="60" />
                        <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>