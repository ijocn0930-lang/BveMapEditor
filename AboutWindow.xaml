<Window x:Class="BveMapEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BveMapEditor"
        mc:Ignorable="d"
Title="バージョン情報" Height="230" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Bve Map Editor" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <!-- ★ (2026-11-19) バージョンは BveMapEditor.csproj の Version から出す（AboutWindow.xaml.cs） -->
        <TextBlock x:Name="TxtVersion" Grid.Row="1" Text="バージョン: " Margin="0,0,0,4"/>
        <TextBlock Grid.Row="2" Text="制作者: テツドウ" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="3" Text="テキストエディタ: AvalonEdit を使用しています。" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <!-- ★ 追加：Bve Map Editor 自体のリポジトリ/ホームページへのリンク -->
        <TextBlock Grid.Row="4" Margin="0,0,0,15">
            <Hyperlink RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://github.com/ijocn0930-lang/BveMapEditor">
                Bve Map Editor (GitHub)
            </Hyperlink>
        </TextBlock>
        <!-- リンクテキスト -->
        <TextBlock Grid.Row="4" VerticalAlignment="Bottom">
            <Hyperlink RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://github.com/icsharpcode/AvalonEdit">
                AvalonEdit (GitHub Repository)
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>
