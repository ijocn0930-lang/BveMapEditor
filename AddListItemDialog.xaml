<Window x:Class="BveMapEditor.AddListItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リストに追加" MinWidth="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False">
    <!-- ★ (2026-11-17) リストファイル（ストラクチャーなど）に「キー,ファイル」の 1 行を足すダイアログ -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TxtListFile" Grid.ColumnSpan="3" TextWrapping="Wrap" MaxWidth="560" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="キー" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox x:Name="TxtKey" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" MinWidth="300" />

        <TextBlock Grid.Row="2" Text="ファイル" VerticalAlignment="Center" Margin="0,4,8,4" />
        <TextBox x:Name="TxtFile" Grid.Row="2" Grid.Column="1" Margin="0,4" MinWidth="300" />
        <Button x:Name="BtnBrowse" Grid.Row="2" Grid.Column="2" Margin="6,4,0,4" Padding="10,0" Click="BtnBrowse_Click">参照…</Button>

        <!-- ★ (2026-11-17) サウンド3D のときだけ出す: 同時に鳴らせる数（3 列目） -->
        <TextBlock x:Name="LblCount" Grid.Row="3" Text="同時に鳴らせる数" VerticalAlignment="Center" Margin="0,4,8,4" Visibility="Collapsed" />
        <TextBox x:Name="TxtCount" Grid.Row="3" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left" Text="1" Visibility="Collapsed" />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,6,0,10" TextWrapping="Wrap" MaxWidth="560" Foreground="Gray"
                   Text="ファイルは、リストファイルのフォルダから見た場所で書き込みます。追加した行は保存していません。リストファイルのタブで確かめてから保存してください（Ctrl+Z で取り消せます）。" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Width="88" Margin="6" IsDefault="True" Click="BtnOk_Click">追加</Button>
            <Button x:Name="BtnCancel" Width="88" Margin="6" IsCancel="True">キャンセル</Button>
        </StackPanel>
    </Grid>
</Window>
