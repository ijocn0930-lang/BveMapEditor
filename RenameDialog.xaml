<Window x:Class="BveMapEditor.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="名前の変更" MinWidth="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False">
    <!-- ★ (2026-11-17) エクスプローラーペインの名前の変更（ファイルは拡張子の前までを選んだ状態で出す） -->
    <StackPanel Margin="12">
        <TextBlock Text="新しい名前を入力してください:" Margin="0,0,0,6" />
        <!-- ★ (2026-11-17) 縦幅が少し足りなかったので、上下に余白を足した（ユーザーより） -->
        <TextBox x:Name="TxtName" MinWidth="380" Padding="2,4" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Width="88" Margin="6,0" IsDefault="True" Click="BtnOk_Click">OK</Button>
            <Button x:Name="BtnCancel" Width="88" Margin="6,0,0,0" IsCancel="True">キャンセル</Button>
        </StackPanel>
    </StackPanel>
</Window>
