<Window x:Class="BveMapEditor.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BveMapEditor"
        mc:Ignorable="d"
        Title="検索と置換" Height="250" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 検索文字列（ComboBoxに変更） -->
            <TextBlock Text="検索する文字列:" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <ComboBox x:Name="CmbSearchQuery" Grid.Column="1" IsEditable="True" VerticalAlignment="Center" Margin="0,0,10,8" />
            <Button Content="次を検索" Grid.Column="2" Width="95" Height="25" VerticalAlignment="Center" Margin="0,0,0,8" Click="BtnFindNext_Click"/>
            <Button Content="閉じる" Grid.Column="3" Width="65" Height="25" VerticalAlignment="Center" Margin="0,0,0,-340" Click="BtnEnd_Click"/>

            <!-- 置換文字列（ComboBoxに変更） -->
            <TextBlock Text="置換後の文字列:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <ComboBox x:Name="CmbReplaceQuery" Grid.Row="1" Grid.Column="1" IsEditable="True" VerticalAlignment="Center" Margin="0,0,10,8" />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical">
                <Button Content="置換" Width="95" Height="25" Margin="0,0,0,4" Click="BtnReplace_Click"/>
                <Button Content="すべて置換" Width="95" Height="25" Click="BtnReplaceAll_Click"/>
            </StackPanel>
            <!-- オプション -->
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Height="72" VerticalAlignment="Top">
                <CheckBox x:Name="ChkMatchCase" Content="大文字と小文字を区別する" Margin="0,0,0,0"/>
                <!-- ★ 追加：単語単位で検索するチェックボックス -->
                <CheckBox x:Name="ChkWholeWord" Content="単語単位で検索する" Margin="0,0,0,4"/>
                <CheckBox x:Name="ChkLoopSearch" Content="最後まで来たら先頭からループする" IsChecked="True" Margin="0,0,0,4"/>
                <CheckBox x:Name="ChkWarnLargeReplace" Content="大量置換時にパフォーマンスの警告を表示する" IsChecked="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
