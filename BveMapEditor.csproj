<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Properties\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- ★ (2026-11-16) デバッグシンボル（.pdb）: Debug は作る（デバッグ・クラッシュログの行番号のため）。
       Release は x64 / AnyCPU に関係なく作らない（発行は x64 なので、以前の「Release|AnyCPU」の条件では効かなかった） -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BveMapParserWorker\**" />
    <Compile Remove="_backup\**" />
    <EmbeddedResource Remove="BveMapParserWorker\**" />
    <EmbeddedResource Remove="_backup\**" />
    <None Remove="BveMapParserWorker\**" />
    <None Remove="_backup\**" />
    <Page Remove="BveMapParserWorker\**" />
    <Page Remove="_backup\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CheckCommandArguments.cs" />
    <Compile Remove="CheckCommandSyntax.cs" />
    <Compile Remove="CommandRules.cs" />
    <Compile Remove="MapParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="abc.txt" />
    <None Remove="AddTrain_KTK_0.txt" />
    <None Remove="bvecommand.txt" />
    <None Remove="Editor01.png" />
    <None Remove="Editor02.png" />
    <None Remove="Editor03.png" />
    <None Remove="map.txt" />
    <None Remove="Plan_Archive.md" />
    <None Remove="system_extensions_list.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Properties\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BveMapParserWorker\BveMapParserWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="BveMap.xshd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- ★ Help フォルダの HTML をまとめて出力フォルダにコピーする（HTML を足しても、ここを書き足さなくてよい） -->
    <None Update="Help\*.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="新しいフォルダー\" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

</Project>
