<Window x:Class="BveMapEditor.FileLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BveMapEditor"
        mc:Ignorable="d"
        Title="FileLoadingWindow" Height="150" Width="300" ShowInTaskbar="False" Topmost="True" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="FileNameTextBlock" Text="ファイルを読み込んでいます..." 
                       TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,0,0,10"/>
            <ProgressBar IsIndeterminate="True" Height="18"/>
        </StackPanel>
    </Grid>
</Window>
